rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-Deny Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate: Fetch parent project to verify live ownership
    function isProjectOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isParentProjectMutable(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.status != 'archived';
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: StudioProject
    function isValidVisualStyle(style) {
      return style in ['cinematic-cinema', 'mythological-epic', 'illustrated-tale', 'noir-thriller', 'stylized-anime'];
    }

    function isValidVoiceProfile(voice) {
      return voice in ['Kore', 'Puck', 'Charon', 'Aoede', 'Fenrir'];
    }

    function isValidCaptionStyle(style) {
      return style in ['cinema-gold', 'clean-subtitle', 'bold-highlight'];
    }

    function isValidProjectStatus(status) {
      return status in ['draft', 'storyboarded', 'rendered', 'archived'];
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'scriptText', 'visualStyle', 'voiceProfile',
          'captionStyle', 'sceneCount', 'totalDurationSec', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'title', 'scriptText', 'visualStyle', 'voiceProfile',
          'captionStyle', 'sceneCount', 'totalDurationSec', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == projectId &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.scriptText is string && data.scriptText.size() <= 180000 &&
        isValidVisualStyle(data.visualStyle) &&
        isValidVoiceProfile(data.voiceProfile) &&
        isValidCaptionStyle(data.captionStyle) &&
        data.sceneCount is number && data.sceneCount >= 0 && data.sceneCount <= 300 &&
        data.totalDurationSec is number && data.totalDurationSec >= 0 && data.totalDurationSec <= 36000 &&
        isValidProjectStatus(data.status) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: StoryboardScene
    function isValidCameraMotion(motion) {
      return motion in ['zoom-in', 'zoom-out', 'pan-left', 'pan-right', 'pan-up', 'pan-down'];
    }

    function isValidCaptionLines(lines) {
      return lines is list &&
        lines.size() >= 0 &&
        lines.size() <= 20 &&
        (lines.size() == 0 || (lines[0] is string && lines[0].size() <= 400));
    }

    function isValidScene(data, projectId, sceneId) {
      return data.keys().hasAll([
          'id', 'projectId', 'ownerId', 'orderIndex', 'titleTe', 'speaker', 'dialogueTe',
          'captionLines', 'visualPromptEn', 'cameraMotion', 'mood', 'voiceDirection',
          'durationSec', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'orderIndex', 'titleTe', 'speaker', 'dialogueTe',
          'captionLines', 'visualPromptEn', 'cameraMotion', 'mood', 'voiceDirection',
          'durationSec', 'staticImagePath', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == sceneId &&
        isValidId(data.projectId) &&
        data.projectId == projectId &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.orderIndex is number && data.orderIndex >= 0 && data.orderIndex <= 500 &&
        data.titleTe is string && data.titleTe.size() >= 1 && data.titleTe.size() <= 300 &&
        data.speaker is string && data.speaker.size() >= 1 && data.speaker.size() <= 120 &&
        data.dialogueTe is string && data.dialogueTe.size() >= 1 && data.dialogueTe.size() <= 5000 &&
        isValidCaptionLines(data.captionLines) &&
        data.visualPromptEn is string && data.visualPromptEn.size() >= 1 && data.visualPromptEn.size() <= 2000 &&
        isValidCameraMotion(data.cameraMotion) &&
        data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 80 &&
        data.voiceDirection is string && data.voiceDirection.size() >= 1 && data.voiceDirection.size() <= 300 &&
        data.durationSec is number && data.durationSec >= 0 && data.durationSec <= 600 &&
        (!('staticImagePath' in data) || (data.staticImagePath is string && data.staticImagePath.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /users/{userId} (PII strictly isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // Collection 2: /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isSignedIn() &&
        isValidId(projectId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidProject(incoming(), projectId) &&
        incoming().status != 'archived' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidProject(incoming(), projectId) &&
        existing().ownerId == request.auth.uid &&
        existing().status != 'archived' &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Edit script, title, or studio style/voice/caption configuration
          (incoming().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'scriptText', 'visualStyle', 'voiceProfile', 'captionStyle',
              'sceneCount', 'totalDurationSec', 'status', 'updatedAt'
            ])) ||
          // Action 2: Archive project (terminal state transition)
          (incoming().status == 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() &&
        isValidId(projectId) &&
        existing().ownerId == request.auth.uid;

      // Subcollection: /projects/{projectId}/scenes/{sceneId}
      match /scenes/{sceneId} {
        allow get: if isSignedIn() &&
          isValidId(projectId) &&
          isValidId(sceneId) &&
          existing().ownerId == request.auth.uid &&
          isProjectOwner(projectId);

        allow list: if isSignedIn() &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(projectId) &&
          isValidId(sceneId) &&
          isValidScene(incoming(), projectId, sceneId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isParentProjectMutable(projectId);

        allow update: if isVerifiedUser() &&
          isValidId(projectId) &&
          isValidId(sceneId) &&
          isValidScene(incoming(), projectId, sceneId) &&
          existing().ownerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isParentProjectMutable(projectId) &&
          (
            // Action 1: Edit scene dialogue, captions, visual prompt, motion, mood, direction, or duration
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderIndex', 'titleTe', 'speaker', 'dialogueTe', 'captionLines',
              'visualPromptEn', 'cameraMotion', 'mood', 'voiceDirection',
              'durationSec', 'staticImagePath', 'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser() &&
          isValidId(projectId) &&
          isValidId(sceneId) &&
          existing().ownerId == request.auth.uid &&
          isProjectOwner(projectId);
      }
    }
  }
}
